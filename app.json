{
  "expo": {
    "description": "A React Native App for https://bgm.tv, tinygrail plugin 260101",
    "version": "8.40.2",
    "android": {
      "versionCode": 904020,
      "package": "com.czy0729.bangumi",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/foreground.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "The app needs to access your calendar."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./src/assets/images/splash_night.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "name": "Bangumi",
    "slug": "bangumi",
    "scheme": "bangumi",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "tv.bangumi.czy0729",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "zh-Hans",
          "zh-Hant",
          "en"
        ],
        "NSCalendarsUsageDescription": "The app needs to access your calendar.",
        "NSRemindersUsageDescription": "Allow $(PRODUCT_NAME) to access your reminders",
        "NSCalendarsFullAccessUsageDescription": "The app needs to access your calendar.",
        "NSRemindersFullAccessUsageDescription": "Allow $(PRODUCT_NAME) to access your reminders",
        "NSLocalNetworkUsageDescription": "需要访问本地网络，用于连接局域网内的 SMB / webDAV 设备",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "smb",
          "http",
          "https"
        ]
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "icon": "./src/assets/images/icon.png",
    "extra": {
      "storybookEnabled": true,
      "eas": {
        "projectId": "ecbab469-60cb-4ec7-b6b7-b90e6d72c937"
      }
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ecbab469-60cb-4ec7-b6b7-b90e6d72c937"
    },
    "assetBundlePatterns": [],
    "githubUrl": "https://github.com/czy0729/Bangumi",
    "runtimeVersion": "1.0.0"
  }
}