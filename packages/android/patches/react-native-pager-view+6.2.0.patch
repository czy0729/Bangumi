+package com.reactnativepagerview
+
+import android.view.MotionEvent
+import android.view.ViewConfiguration
+import androidx.recyclerview.widget.RecyclerView
+import androidx.viewpager2.widget.ViewPager2
+import kotlin.math.abs
+
+/**
+ * 修复横向 ViewPager2 内嵌垂直滚动列表时, 竖直滑动被 pager 抢走的问题。
+ *
+ * 根因: RecyclerView 拦截手势只判断本方向单轴位移是否超过 touchSlop,
+ * 不判断手势整体方向。横向 pager 只要 |dx| > touchSlop 就会抢走手势,
+ * 即使用户主要是在垂直滑动 (手指稍有横向漂移即触发, 列表滑到底时尤其明显)。
+ *
+ * 修复: 记录手势起点, 第一次超过 touchSlop 时判定主导方向。
+ * 竖向主导时通过 requestDisallowInterceptTouchEvent 让 pager 不再拦截后续事件,
+ * 事件直达子列表, 不会锁死手势。
+ */
+object DirectionAwarePagerHelper {
+  fun attach(viewPager: ViewPager2) {
+    if (viewPager.orientation != ViewPager2.ORIENTATION_HORIZONTAL) return
+    val recycler = viewPager.getChildAt(0) as RecyclerView
+    val touchSlop = ViewConfiguration.get(viewPager.context).scaledTouchSlop
+    var startX = 0f
+    var startY = 0f
+    var decided = false
+
+    recycler.addOnItemTouchListener(object : RecyclerView.OnItemTouchListener {
+      override fun onInterceptTouchEvent(rv: RecyclerView, e: MotionEvent): Boolean {
+        when (e.actionMasked) {
+          MotionEvent.ACTION_DOWN -> {
+            startX = e.x
+            startY = e.y
+            decided = false
+          }
+          MotionEvent.ACTION_MOVE -> {
+            if (!decided) {
+              val dx = e.x - startX
+              val dy = e.y - startY
+              if (abs(dx) > touchSlop || abs(dy) > touchSlop) {
+                decided = true
+                // 竖向主导时设置 disallow 标志, pager 从下一个 move 起不再拦截,
+                // 事件直接交给子列表; UP/CANCEL 时系统自动清除该标志。
+                // directionLockRatio: 判定方向的比例阈值, 竖向主导需 |dy| > ratio * |dx|。
+                // ratio > 1 时水平滑动更跟手, 轻微的纵向漂移不会误锁。
+                val ratio = (viewPager.parent as? NestedScrollableHost)?.directionLockRatio ?: 1.5f
+                if (abs(dy) > ratio * abs(dx)) {
+                  rv.requestDisallowInterceptTouchEvent(true)
+                }
+              }
+            }
+          }
+        }
+        return false
+      }
+
+      override fun onTouchEvent(rv: RecyclerView, e: MotionEvent) {}
+
+      override fun onRequestDisallowInterceptTouchEvent(disallowIntercept: Boolean) {}
+    })
+  }
+}
