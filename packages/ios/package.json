{
  "name": "bangumi-pro",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start --max-workers 4",
    "dev:offline": "expo start --offline --max-workers 4",
    "dev:tee": "yarn dev | tee -a output.txt",
    "postinstall": "patch-package",
    "env": "node ./packages/env.js",
    "k": "sudo purge",
    "kj": "ps -ef | grep java | awk 'NR==1 {print $2}' | xargs kill -15",
    "kp": "lsof -i :8081 | awk 'NR>1 {print $2}' | xargs kill",
    "r": "sudo shutdown -r now",
    "top": "top -s 4 -o rsize",
    "mv": "yarn k && mv ios ios_ && mv android android_",
    "pub": "eas update --channel production --platform ios --message \"release\"",
    "re": "mv ios_ ios && mv android_ android && yarn k",
    "open:win": "start .\\android\\app\\build\\outputs\\apk\\release\\",
    "build:ipa": "cd ios && xcodebuild -workspace Bangumi.xcworkspace -scheme Bangumi -configuration Release -sdk iphoneos CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO -derivedDataPath build",
    "make:ipa": "node web/ipa.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --forceExit",
    "pb:verify": "node scripts/pb-verify.js",
    "tag:verify": "node scripts/tag-verify.js",
    "lint:styles": "npx eslint 'src/**/styles.ts'",
    "lint:imports": "npx eslint 'src/**/*.{ts,tsx}' --quiet --config eslint-rules/.eslintrc.check-imports.js",
    "fixed:chown": "sudo chown -R $(whoami):staff node_modules metro-cache dist android ios"
  },
  "resolutions": {
    "define-properties": "1.2.0",
    "use-latest-callback": "0.1.9"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/blur": "4.4.1",
    "@react-native-community/cameraroll": "4.0.4",
    "@react-native-community/slider": "5.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "6.5.8",
    "@react-navigation/native": "6.1.7",
    "@react-navigation/native-stack": "6.9.13",
    "@sdcx/nested-scroll": "^0.14.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-blur": "~58.0.5",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-screen-orientation": "~58.0.4",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "htmlparser2": "^3.9.0",
    "mobx": "6.12.3",
    "mobx-react": "9.1.1",
    "patch-package": "6.4.7",
    "postinstall-postinstall": "2.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-exception-handler": "^2.10.8",
    "react-native-fast-image": "8.5.11",
    "react-native-fs": "2.18.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-realtimeblurview": "1.1.3",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "4.1.1",
    "react-native-restart": "0.0.14",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-smb": "^0.2.4",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "3.5.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "rn-fetch-blob": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-react": "^7.27.1",
    "@react-native-community/eslint-config": "^3.0.1",
    "@react-native/jest-preset": "~0.88.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cheerio": "1.0.0",
    "cheerio-without-node-native": "0.20.2",
    "crypto-js": "^4.2.0",
    "dayjs": "1.10.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-bangumi": "file:./eslint-rules",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^2.6.2",
    "protobufjs": "^8.8.0",
    "stream-browserify": "^3.0.0",
    "typescript": "^6.0.3",
    "babel-preset-expo": "~58.0.24"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-realtimeblurview",
          "@sdcx/nested-scroll"
        ]
      }
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
